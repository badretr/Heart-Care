# ----- Terraform -----
# Etat : contient des valeurs sensibles en clair, ne jamais versionner.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Repertoires de travail et verrous locaux
**/.terraform/
.terraform.lock.hcl

# Plans binaires
*.tfplan
tfplan
plan.txt

# Variables : seuls les .tfvars.example sont versionnes.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Fichiers de surcharge locaux
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Journaux d'execution Terraform
crash.log
crash.*.log

# ----- Identifiants -----
.aws/
credentials
*.pem
*.key

# ----- Django -----
*.log
*.pot
*.pyc
__pycache__/
db.sqlite3
media/
staticfiles/
.env
venv/
.venv/

# ----- Editeurs et systeme -----
.vscode/
.idea/
*.swp
.DS_Store
