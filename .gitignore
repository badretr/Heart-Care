# ----- Terraform -----
# Etat : contient des valeurs sensibles en clair, ne jamais versionner.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Repertoires de travail et verrous locaux
**/.terraform/
.terraform.lock.hcl

# Plans binaires
*.tfplan
tfplan
plan.txt

# Variables.
# Les tfvars des environnements SONT versionnes : ils ne contiennent aucun
# secret, et en faire la source de verite unique garantit que le pipeline et
# le poste de developpement planifient sur les memes entrees.
# Le mot de passe de la base passe par TF_VAR_db_password.
*.tfvars
*.tfvars.json
!*.tfvars.example
!terraform/environments/*/terraform.tfvars

# Fichiers de surcharge locaux
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Journaux d'execution Terraform
crash.log
crash.*.log

# ----- Identifiants -----
.aws/
credentials
*.pem
*.key

# ----- Django -----
*.log
*.pot
*.pyc
__pycache__/
db.sqlite3
media/
staticfiles/
.env
venv/
.venv/

# ----- Editeurs et systeme -----
.vscode/
.idea/
*.swp
.DS_Store
